{
  "name": "alongside-xr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared spatial annotation with room-scoped AI and MCP collaborators",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:remote": "node --env-file-if-exists=.env server/index.js --tunnel",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:liveview": "node tests/liveview-browser.mjs",
    "verify:release": "node tests/verify-release.mjs",
    "test:writing": "node tests/collaboration-browser.mjs",
    "simulate:camera": "node examples/simulated-camera.mjs",
    "fake-quest": "node examples/fake-quest.mjs",
    "test:mcp": "node examples/smoke-mcp.mjs",
    "mcp:demo": "node examples/mcp-agent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "bonjour-service": "^1.4.4",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.51.0",
    "prettier": "^3.10.1",
    "vite": "^6.2.0"
  }
}
