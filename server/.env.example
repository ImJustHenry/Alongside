# Copy to .env. Node 22+ loads this file through npm start / npm run dev.
PORT=4173
# For deployment, set this to the exact HTTPS origin, with no trailing slash.
# Multiple explicitly trusted origins can be comma-separated.
PUBLIC_ORIGIN=
# Set to 1 only behind your trusted reverse proxy, which must overwrite forwarding headers.
TRUST_PROXY=0
# Optional direct HTTPS server using a certificate trusted by ALL participating devices.
HTTPS_KEY=
HTTPS_CERT=
# Optional absolute path to room persistence. Default: data/rooms.json.
DATA_FILE=
# Shizuku voice + vision companion (server-side only; never sent to clients).
# Paste your own key here in .env (not .env.example), then restart the server.
OPENAI_API_KEY=
# Optional overrides
SHIZUKU_MODEL=gpt-4o-mini
SHIZUKU_STT_MODEL=gpt-4o-mini-transcribe
SHIZUKU_TTS_MODEL=gpt-4o-mini-tts
SHIZUKU_VOICE=coral
